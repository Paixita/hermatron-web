[TEMPLATE]
# Clave de API de Groq (obténla en https://console.groq.com)
GROQ_API_KEY=tu_api_key_aqui

# Clave de API de Serper para búsquedas web (opcional, https://serper.dev)
SERPER_API_KEY=tu_api_key_aqui

# Puerto del servidor
PORT=5000

# Host del servidor
HOST=0.0.0.0

# Modo debug (True para desarrollo, False para producción)
DEBUG=True

# Modelo de Groq a usar
GROQ_MODEL=llama-3.3-70b-versatile

# Voz para Edge-TTS (ej: es-MX-JorgeNeural, es-CO-GonzaloNeural, etc.)
TTS_VOICE=es-MX-JorgeNeural

# --- OpenRouter (proveedor alternativo con +200 modelos IA) ---
# Obten tu key en https://openrouter.ai/keys
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
# Modelo a usar en OpenRouter (ver lista en https://openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Proveedor activo: "groq" (por defecto) o "openrouter"
LLM_PROVIDER=groq

# ── Agente interno Qwen 3 (GRATIS: Ollama local / OpenRouter :free) ──
QWEN3_ENABLED=True
QWEN3_API_KEY=
QWEN3_BASE_URL=http://localhost:11434/v1
QWEN3_MODEL=qwen3:8b

# ── Duración objetivo del video (segundos) ──
VIDEO_MIN_DURATION=8
VIDEO_MAX_DURATION=15

# Seguridad: True = HERMATRON puede ejecutar Python/comandos en tu PC desde el chat
ALLOW_SYSTEM_COMMANDS=True

# Servicios Avanzados del Agente (v6.2)
# True = HERMATRON puede navegar/crear/copiar/mover/eliminar carpetas y archivos del PC
ALLOW_FILE_ACCESS=True

# Token de GitHub OPCIONAL (gratis) para el agente:
# Ve a https://github.com/settings/tokens -> Generate new token (fine-grained,
# sin permisos especiales basta) y pega el token aquí. Sin token HERMATRON usa
# la API pública gratuita de GitHub (10 búsquedas/min, 60 peticiones/h).
GITHUB_TOKEN=